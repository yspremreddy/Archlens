# Copy to .env and adjust if needed. All values below are local-dev
# defaults — nothing here is a real secret (see CLAUDE.md: don't hardcode
# secrets). For any non-local deployment these must be overridden.

POSTGRES_DB=archlens
POSTGRES_USER=archlens
POSTGRES_PASSWORD=archlens_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Used by the app (SQLAlchemy). Built from the POSTGRES_* values above by
# default in config.py if DATABASE_URL is not set explicitly.
# DATABASE_URL=postgresql+psycopg://archlens:archlens_dev_password@localhost:5432/archlens

# Local filesystem directory where uploaded document bytes are stored.
STORAGE_DIR=./data/storage

# Local, open-source embedding model (via fastembed, ONNX runtime — no
# API key, no network calls at inference time; the model weights are
# downloaded once from Hugging Face on first use and cached locally).
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Phase 3 generation. "template" (default) is a zero-dependency,
# deterministic extractive fallback — no model, no network, always
# available. Set to "ollama" to use a real local LLM via a locally
# running Ollama server (https://ollama.com — free, no API key; install
# it yourself and `ollama pull <model>` first). Never a paid API.
LLM_PROVIDER=template
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Minimum lexical-overlap score (0-1) for a generated answer to be
# flagged as grounded — see app/generation/groundedness.py.
GROUNDEDNESS_MIN_SCORE=0.3

# Phase 4 reranking. Local cross-encoder (fastembed/ONNX, no API key, no
# network calls after the one-time model download). Applied after
# retrieval and before generation, only to the top RERANK_CANDIDATE_POOL
# candidates — see app/retrieval/rerank.py.
RERANK_ENABLED=true
RERANK_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=20

# Phase 5 — Neo4j Community Edition via Docker (free, local, no
# license). NEO4J_USER/NEO4J_PASSWORD below are also read directly by
# docker-compose.yml to set NEO4J_AUTH.
NEO4J_USER=neo4j
NEO4J_PASSWORD=archlens_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
GRAPH_MAX_HOPS=4

# Phase 6 — multimodal (diagram) ingestion. OCR (rapidocr-onnxruntime)
# always runs — no model choice, no opt-in. Vision captioning is
# optional and off by default ("none"): a diagram is still fully
# OCR-searchable with no vision model at all. Set to "ollama" for real
# vision captioning/relationship extraction via a locally-running Ollama
# server with a vision-capable model (default `moondream`, ~1.7GB —
# `ollama pull moondream` first). Never a paid API.
VISION_PROVIDER=none
VISION_MODEL=moondream

# Phase 9 — OpenTelemetry tracing. Off by default; enabling it requires
# an OTLP collector running locally (e.g. a free, local Arize Phoenix:
# `docker run -p 6006:6006 -p 4317:4317 arizephoenix/phoenix`). Never a
# paid observability service.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=archlens-api
